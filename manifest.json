{
  "manifest_version": 3,
  "name": "RemoteFs Explorer",
  "version": "0.1.0",
  "key": "",
  "description": "统一浏览 SSH、S3/OSS/MinIO 和本地文件，支持预览、编辑与超大图片缩放。",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms",
    "clipboardWrite",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "打开 RemoteFs Explorer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "js": [
        "object-storage-links.js"
      ],
      "css": [
        "object-storage-links.css"
      ],
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app.html",
        "app.js",
        "styles.css",
        "vendor/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
