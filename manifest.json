{
  "manifest_version": 3,
  "name": "AnyFs Browser",
  "version": "0.1.0",
  "key": "",
  "description": "统一浏览本地、SSH 和 S3/OSS 文件，支持超大图片流畅缩放。",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "打开 AnyFs Browser"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "js": [
        "object-storage-links.js"
      ],
      "css": [
        "object-storage-links.css"
      ],
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
